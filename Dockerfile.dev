# ===============================================
# Dockerfile para Desenvolvimento (Hot Reload)
# ===============================================
FROM node:22-alpine

WORKDIR /app

# Copia manifestos de pacotes
COPY package*.json ./

# Instala todas as dependências
RUN npm ci

# Copia código-fonte
COPY . .

EXPOSE 3000

# Hot reload com nest start --watch
CMD ["npm", "run", "start:dev"]
