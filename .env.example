PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-secret-key-here-min-16-chars
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=your-refresh-secret-key-here-min-16
JWT_REFRESH_EXPIRATION_DAYS=7

# Redis Configuration (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=nest_uploads

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=nest_api

# Gemini AI Configuration (gratuito para uso pessoal)
GEMINI_API_KEY=your_gemini_api_key_here
